pipeline {
    agent any

    triggers {
        pollSCM('H/2 * * * *')
    }

    environment {
        NOTIFY_EMAIL = 'talhasohail501501@gmail.com'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Talha-Team-SIT223/8.2CDevSecOps.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'npm test || true'
            }
            post {
                always {
                    emailext(
                        subject: "[Run Tests] Build #${env.BUILD_NUMBER} - ${currentBuild.currentResult}",
                        body: "Pipeline: ${env.JOB_NAME}\nBuild number: ${env.BUILD_NUMBER}\nStage: Run Tests\nStatus: ${currentBuild.currentResult}\n\nThe full console log is attached.",
                        to: "${env.NOTIFY_EMAIL}",
                        attachLog: true
                    )
                }
            }
        }

        stage('Generate Coverage Report') {
            steps {
                sh 'npm run coverage || true'
            }
        }

        stage('NPM Audit (Security Scan)') {
            steps {
                sh 'npm audit || true'
            }
            post {
                always {
                    emailext(
                        subject: "[Security Scan] Build #${env.BUILD_NUMBER} - ${currentBuild.currentResult}",
                        body: "Pipeline: ${env.JOB_NAME}\nBuild number: ${env.BUILD_NUMBER}\nStage: NPM Audit (Security Scan)\nStatus: ${currentBuild.currentResult}\n\nThe full console log is attached.",
                        to: "${env.NOTIFY_EMAIL}",
                        attachLog: true
                    )
                }
            }
        }
    }
}

